# DarkerDB API (required for market/items — v1 is gone, v2 needs a key)
# Create one at https://darkerdb.com/dashboard/api-keys
# Enable scopes: darkerdb.data + darkerdb.live
DARKERDB_API_KEY=
# Must match an Origin allowlisted on the key (leave empty only if the key has no Origins set)
DARKERDB_ORIGIN=https://www.bisloot.website

# Google AdSense (optional). Fill in after approval.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_AD_SLOT_FOOTER=1234567890
# NEXT_PUBLIC_AD_SLOT_MARKET_SIDEBAR=0987654321
