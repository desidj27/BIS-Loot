# DarkerDB API (required for market/items — v1 is gone, v2 needs a key)
# Create one at https://darkerdb.com/dashboard/api-keys
# Enable scopes: darkerdb.data + darkerdb.live
DARKERDB_API_KEY=
# Must match an Origin allowlisted on the key (leave empty only if the key has no Origins set)
DARKERDB_ORIGIN=https://www.bisloot.website

# Google AdSense (optional). Fill in after approval.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_AD_SLOT_FOOTER=1234567890
# NEXT_PUBLIC_AD_SLOT_MARKET_SIDEBAR=0987654321

# Discord login (required for Watchers)
# Create an app at https://discord.com/developers/applications
# OAuth2 → Redirects: http://localhost:3000/api/auth/callback/discord
# and https://www.bisloot.website/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AUTH_SECRET=
# Optional override; defaults to the current origin + /api/auth/callback/discord
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

# Optional: persist watchers across Vercel deploys (https://upstash.com)
# Also used to share DarkerDB market/item caches across serverless instances
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Vercel Cron secret (auto-set on Vercel). Enables 5-minute watcher
# checks even when nobody has BisLoot open.
# CRON_SECRET=
